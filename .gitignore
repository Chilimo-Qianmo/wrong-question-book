# ---------------------------------------------------------------------------
/dist/
/build/
/*.exe
*.manifest
*.toc
warn-*.txt
xref-*.html
localpycs/

# ---------------------------------------------------------------------------
# 7. Node / 前端
# ---------------------------------------------------------------------------
node_modules/
web/node_modules/
web/dist/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

