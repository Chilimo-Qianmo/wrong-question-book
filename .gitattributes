# 统一换行风格：仓库内文本一律 LF，避免跨平台 diff 噪声
* text=auto

# Windows 脚本必须保持 CRLF，否则 cmd.exe 解析可能出错
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.exe binary
*.zip binary
*.onnx binary

# 锁文件不计入语言统计，避免仓库页显示为自动生成
web/package-lock.json linguist-generated=true
